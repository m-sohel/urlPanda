{
  "manifest_version": 3,
  "name": "urlPanda",
  "version": "0.1",
  "description": "A simple extension to save and manage important URLs.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_popup": "popup.html"
  }
}