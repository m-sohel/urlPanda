{
  "manifest_version": 3,
  "name": "urlPanda",
  "version": "1.0.0",
  "description": "Organize links with folders, tags, reading lists, instant search, duplicate alerts, and JSON backup.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
